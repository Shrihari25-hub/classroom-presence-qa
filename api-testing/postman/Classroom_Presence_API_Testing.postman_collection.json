				{
					"name": "AUTH_TC_006 - Login with Valid Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Verify successful login\r",
									"pm.test(\"Login status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"// Test 2: Verify JWT token is present\r",
									"pm.test(\"Login response contains a token\", function () {\r",
									"    const response = pm.response.json();\r",
									"\r",
									"    pm.expect(response).to.have.property(\"token\");\r",
									"    pm.expect(response.token).to.be.a(\"string\").and.not.empty;\r",
									"});\r",
									"\r",
									"// Test 3: Verify user information is present\r",
									"pm.test(\"Login response contains user details\", function () {\r",
									"    const response = pm.response.json();\r",
									"\r",
									"    pm.expect(response).to.have.property(\"user\");\r",
									"    pm.expect(response.user).to.be.an(\"object\");\r",
									"});\r",
									"\r",
									"// Test 4: Verify user details are correct\r",
									"pm.test(\"Verify teacher account details\", function () {\r",
									"    const response = pm.response.json();\r",
									"\r",
									"    pm.expect(response.user.name).to.eql(\"QA Test Teacher\");\r",
									"    pm.expect(response.user.email).to.eql(\"qa.teacher001@example.com\");\r",
									"    pm.expect(response.user.role).to.eql(\"teacher\");\r",
									"});\r",
									"\r",
									"// Test 5: Verify sensitive fields are not exposed\r",
									"pm.test(\"Password and face embeddings are not exposed\", function () {\r",
									"    const response = pm.response.json();\r",
									"\r",
									"    pm.expect(response.user).to.not.have.property(\"password\");\r",
									"    pm.expect(response.user).to.not.have.property(\"faceEmbeddings\");\r",
									"});\r",
									"const response = pm.response.json();\r",
									"\r",
									"if (pm.response.code === 200 && response.token) {\r",
									"    pm.environment.set(\"token\", response.token);\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
